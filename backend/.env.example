# Copy to backend/.env to override defaults. All values are optional.
ENHANCER_HOST=127.0.0.1
ENHANCER_PORT=8000
ENHANCER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENHANCER_ALLOWED_HOSTS=127.0.0.1,localhost

# auto = use the NVIDIA GPU when PyTorch sees it, otherwise CPU.  cpu = force CPU.
ENHANCER_DEVICE=auto
ENHANCER_FP16=1
# 0 = choose the tile size from free VRAM. Lower it (e.g. 128) if you hit out-of-memory.
ENHANCER_TILE_SIZE=0

# Limits
ENHANCER_MAX_UPLOAD_MB=50
ENHANCER_MAX_FILES_PER_UPLOAD=20
ENHANCER_MAX_INPUT_PIXELS=40000000
ENHANCER_MAX_OUTPUT_PIXELS=150000000
ENHANCER_MAX_OUTPUT_SIDE=16384
ENHANCER_JOB_TIMEOUT_S=1800

# Uploaded images and results are deleted after this many hours.
ENHANCER_FILE_TTL_HOURS=24
